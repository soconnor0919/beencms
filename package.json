{
  "name": "hadlockcms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <26"
  },
  "scripts": {
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:baseline": "tsx --tsconfig tsconfig.json scripts/baseline-migrations.ts",
    "db:backup": "tsx --tsconfig tsconfig.json scripts/backup.ts",
    "db:check": "tsx --tsconfig tsconfig.json scripts/check-database.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --tsconfig tsconfig.json scripts/seed.ts",
    "db:seed:trellis": "tsx --tsconfig tsconfig.json clients/trellis/seed.ts",
    "db:restore": "tsx --tsconfig tsconfig.json scripts/restore.ts",
    "dev": "next dev --turbo",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
