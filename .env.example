# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Drizzle
DATABASE_URL="./db.sqlite"

# BetterAuth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3000"

# Email delivery. "auto" prefers Resend when an API key is present, then SMTP.
EMAIL_PROVIDER="auto"
# RESEND_API_KEY="re_xxxxxxxxx"
# EMAIL_FROM="Website <noreply@your-verified-domain.com>"

# Optional SMTP fallback/alternative
# EMAIL_SMTP_HOST="smtp.example.com"
# EMAIL_SMTP_PORT="587"
# EMAIL_SMTP_USER="user@example.com"
# EMAIL_SMTP_PASS="replace-me"
# EMAIL_TO="contact@example.com"

# Agent control via Model Context Protocol. Generate with: openssl rand -hex 32
# HADLOCKCMS_MCP_TOKEN="replace-with-at-least-32-random-characters"

# Optional client provisioning for a deployment that includes Trellis.
# PROVISION_TRELLIS="true"
# TRELLIS_HOSTNAME="trellis.example.com"
# TRELLIS_OWNER_EMAIL="admin@trelliswd.org"
# TRELLIS_OWNER_PASSWORD="replace-with-a-strong-password"

# Optional Cloudflare Turnstile protection for public forms
# NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-site-key"
# TURNSTILE_SECRET_KEY="your-secret-key"

# Media storage. Local is suitable for development and single-server installs.
STORAGE_DRIVER="local"
# For AWS S3, Cloudflare R2, Backblaze B2, MinIO, or another S3-compatible service:
# STORAGE_DRIVER="s3"
# STORAGE_BUCKET="hadlockcms-media"
# STORAGE_REGION="auto"
# STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# STORAGE_ACCESS_KEY_ID="replace-me"
# STORAGE_SECRET_ACCESS_KEY="replace-me"
# STORAGE_PUBLIC_URL="https://media.example.com"

# Optional Stripe Billing. Prefer a least-privilege restricted key (rk_...).
# STRIPE_SECRET_KEY="rk_test_xxxxxxxxx"
# STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxx"
# STRIPE_PRICE_STARTER="price_xxxxxxxxx"
# STRIPE_PRICE_PROFESSIONAL="price_xxxxxxxxx"
# STRIPE_PRICE_BUSINESS="price_xxxxxxxxx"
